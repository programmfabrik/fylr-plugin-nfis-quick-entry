ZIP_NAME ?= "nfisQuickEntry.zip"
PLUGIN_NAME = nifs-quick-entry

## Style Files
SCSS_FILES = src/webfrontend/scss/NfisQuickEntry.scss

## HTML Files
HTML_FILES = \
    src/webfrontend/html/NfisQuickEntry.html \

L10N_CSV_FILE = l10n/NfisQuickEntry.csv

help:
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}'

all: build zip ## build and zip

build: clean buildinfojson ## build plugin

	mkdir -p build
	mkdir -p build/$(PLUGIN_NAME)
	mkdir -p build/$(PLUGIN_NAME)/l10n
	mkdir -p build/$(PLUGIN_NAME)/webfrontend

	mkdir -p src/tmp # build code from coffee
	cp src/webfrontend/js/*.js src/tmp
	cat src/tmp/*.js > build/$(PLUGIN_NAME)/webfrontend/NfisQuickEntry.js
	rm -rf src/tmp # clean tmp

	cat $(HTML_FILES) > build/$(PLUGIN_NAME)/webfrontend/NfisQuickEntry.html

	sass $(SCSS_FILES):build/$(PLUGIN_NAME)/webfrontend/NfisQuickEntry.css

	cp $(L10N_CSV_FILE) build/$(PLUGIN_NAME)/l10n

	## cp -r node_modules build/$(PLUGIN_NAME)/

	cp manifest.master.yml build/$(PLUGIN_NAME)/manifest.yml # copy manifest

	cp build-info.json build/$(PLUGIN_NAME)/build-info.json

buildinfojson:
	repo=`git remote get-url origin | sed -e 's/\.git$$//' -e 's#.*[/\\]##'` ;\
	rev=`git show --no-patch --format=%H` ;\
	lastchanged=`git show --no-patch --format=%ad --date=format:%Y-%m-%dT%T%z` ;\
	builddate=`date +"%Y-%m-%dT%T%z"` ;\
	echo '{' > build-info.json ;\
	echo '  "repository": "'$$repo'",' >> build-info.json ;\
	echo '  "rev": "'$$rev'",' >> build-info.json ;\
	echo '  "lastchanged": "'$$lastchanged'",' >> build-info.json ;\
	echo '  "builddate": "'$$builddate'"' >> build-info.json ;\
	echo '}' >> build-info.json

clean: ## clean
	rm -rf build src/temp

zip: build ## zip file
	cd build && zip ${ZIP_NAME} -r $(PLUGIN_NAME)/
